# ---------------------------------------------------------------------------
# Launch gate
# coming_soon = public sees the holding page | live = full site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LAUNCH_MODE=live

# ---------------------------------------------------------------------------
# Data source
# true  = every service resolves from src/data (no backend required)
# false = services call the FastAPI backend through the Next proxy
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCKS=true

# ---------------------------------------------------------------------------
# Backend. API_BASE_URL is server-only — the browser never talks to FastAPI
# directly, it goes through /api/proxy so the JWT can stay in an httpOnly cookie.
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1

# Cookie behaviour. Set COOKIE_SECURE=true in any deployed environment.
COOKIE_SECURE=false
